<?xml version="1.0" encoding="UTF-8"?>
<!--
  Feed catalog for The Hacker Dispatch: a short list of high-signal security feeds, RSS and Atom
  only, every URL checked on 2026-10-19. Import it in the admin panel (sources -> Import OPML).
  Every feed sits under "Security", so it goes to that section; the groups inside are only for
  reading. Primary sources (advisories, CERTs, research teams) come first, news last.
-->
<opml version="2.0">
  <head><title>The Hacker Dispatch feed catalog</title></head>
  <body>
    <outline text="Security">
      <outline text="Vulnerability notes and disclosure lists">
        <outline type="rss" text="CERT/CC Vulnerability Notes" title="CERT/CC Vulnerability Notes" xmlUrl="https://www.kb.cert.org/vuls/atomfeed/"/>
        <outline type="rss" text="oss-security (mailing list)" title="oss-security (mailing list)" xmlUrl="https://seclists.org/rss/oss-sec.rss"/>
      </outline>
      <outline text="Governments and CERTs">
        <outline type="rss" text="CISA — all advisories" title="CISA — all advisories" xmlUrl="https://www.cisa.gov/cybersecurity-advisories/all.xml"/>
        <outline type="rss" text="SANS Internet Storm Center" title="SANS Internet Storm Center" xmlUrl="https://isc.sans.edu/rssfeed_full.xml"/>
        <outline type="rss" text="NCSC UK" title="NCSC UK" xmlUrl="https://www.ncsc.gov.uk/api/1/services/v1/all-rss-feed.xml"/>
        <outline type="rss" text="CERT-EU — security advisories" title="CERT-EU — security advisories" xmlUrl="https://cert.europa.eu/publications/security-advisories-rss"/>
      </outline>
      <outline text="Vendor advisories">
        <outline type="rss" text="Microsoft Security Update Guide" title="Microsoft Security Update Guide" xmlUrl="https://api.msrc.microsoft.com/update-guide/rss"/>
        <outline type="rss" text="Cisco PSIRT" title="Cisco PSIRT" xmlUrl="https://sec.cloudapps.cisco.com/security/center/psirtrss20/CiscoSecurityAdvisory.xml"/>
        <outline type="rss" text="Fortinet PSIRT" title="Fortinet PSIRT" xmlUrl="https://filestore.fortinet.com/fortiguard/rss/ir.xml"/>
        <outline type="rss" text="Palo Alto Networks security advisories" title="Palo Alto Networks security advisories" xmlUrl="https://security.paloaltonetworks.com/rss.xml"/>
        <outline type="rss" text="Ivanti security advisories" title="Ivanti security advisories" xmlUrl="https://www.ivanti.com/blog/topics/security-advisory/rss"/>
        <outline type="rss" text="Google Chrome Releases" title="Google Chrome Releases" xmlUrl="https://chromereleases.googleblog.com/feeds/posts/default"/>
        <outline type="rss" text="AWS security bulletins" title="AWS security bulletins" xmlUrl="https://aws.amazon.com/security/security-bulletins/rss/feed/"/>
      </outline>
      <outline text="Threat intelligence research">
        <outline type="rss" text="Google Threat Intelligence Group (Mandiant)" title="Google Threat Intelligence Group (Mandiant)" xmlUrl="https://cloudblog.withgoogle.com/topics/threat-intelligence/rss/"/>
        <outline type="rss" text="Microsoft Threat Intelligence" title="Microsoft Threat Intelligence" xmlUrl="https://www.microsoft.com/en-us/security/blog/topic/threat-intelligence/feed/"/>
        <outline type="rss" text="Cisco Talos" title="Cisco Talos" xmlUrl="https://blog.talosintelligence.com/rss/"/>
        <outline type="rss" text="Palo Alto Unit 42" title="Palo Alto Unit 42" xmlUrl="https://unit42.paloaltonetworks.com/feed/"/>
        <outline type="rss" text="SentinelLabs" title="SentinelLabs" xmlUrl="https://www.sentinelone.com/labs/feed/"/>
        <outline type="rss" text="Kaspersky Securelist" title="Kaspersky Securelist" xmlUrl="https://securelist.com/feed/"/>
        <outline type="rss" text="ESET WeLiveSecurity" title="ESET WeLiveSecurity" xmlUrl="https://www.welivesecurity.com/en/rss/feed/"/>
        <outline type="rss" text="Check Point Research" title="Check Point Research" xmlUrl="https://research.checkpoint.com/feed/"/>
        <outline type="rss" text="Proofpoint Threat Insight" title="Proofpoint Threat Insight" xmlUrl="https://www.proofpoint.com/us/threat-insight-blog.xml"/>
        <outline type="rss" text="The DFIR Report" title="The DFIR Report" xmlUrl="https://thedfirreport.com/feed/"/>
        <outline type="rss" text="Volexity" title="Volexity" xmlUrl="https://www.volexity.com/feed/"/>
        <outline type="rss" text="Citizen Lab" title="Citizen Lab" xmlUrl="https://citizenlab.ca/feed/"/>
      </outline>
      <outline text="Vulnerability research">
        <outline type="rss" text="Google Project Zero" title="Google Project Zero" xmlUrl="https://projectzero.google/feed.xml"/>
        <outline type="rss" text="watchTowr Labs" title="watchTowr Labs" xmlUrl="https://labs.watchtowr.com/rss/"/>
        <outline type="rss" text="PortSwigger Research" title="PortSwigger Research" xmlUrl="https://portswigger.net/research/rss"/>
        <outline type="rss" text="GitHub Security Lab" title="GitHub Security Lab" xmlUrl="https://github.blog/tag/github-security-lab/feed/"/>
      </outline>
      <outline text="Security news">
        <outline type="rss" text="BleepingComputer" title="BleepingComputer" xmlUrl="https://www.bleepingcomputer.com/feed/"/>
        <outline type="rss" text="The Record (Recorded Future News)" title="The Record (Recorded Future News)" xmlUrl="https://therecord.media/feed/"/>
        <outline type="rss" text="The Hacker News" title="The Hacker News" xmlUrl="https://feeds.feedburner.com/TheHackersNews"/>
        <outline type="rss" text="Krebs on Security" title="Krebs on Security" xmlUrl="https://krebsonsecurity.com/feed/"/>
        <outline type="rss" text="SecurityWeek" title="SecurityWeek" xmlUrl="https://www.securityweek.com/feed/"/>
        <outline type="rss" text="Risky Bulletin (Risky Business News)" title="Risky Bulletin (Risky Business News)" xmlUrl="https://news.risky.biz/rss/"/>
        <outline type="rss" text="Ars Technica — security" title="Ars Technica — security" xmlUrl="https://arstechnica.com/security/feed/"/>
        <outline type="rss" text="DataBreaches.net" title="DataBreaches.net" xmlUrl="https://databreaches.net/feed/"/>
      </outline>
      <outline text="Community">
        <outline type="rss" text="Hacker News — security (100+ points)" title="Hacker News — security (100+ points)" xmlUrl="https://hnrss.org/newest?points=100&amp;q=security+OR+vulnerability+OR+exploit+OR+breach"/>
        <outline type="rss" text="r/netsec" title="r/netsec" xmlUrl="https://www.reddit.com/r/netsec/.rss"/>
      </outline>
    </outline>
  </body>
</opml>
