# Copy to secrets.env and fill in. secrets.env must never be committed.

# Required: the PostgreSQL database.
DATABASE_URL=postgres://thehacker:CHANGE_ME@postgres.example.internal:5432/thehackerdispatch?sslmode=require

# Required: encrypts LLM API keys stored in the database. Generate with: openssl rand -base64 32
SECRETS_KEY=

# Optional: Slack bot token, for notifications.
SLACK_BOT_TOKEN=

# Optional: the Keycloak client secret, when OIDC_ISSUER_URL and OIDC_CLIENT_ID are set.
OIDC_CLIENT_SECRET=
