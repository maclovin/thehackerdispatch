# Non-secret settings, turned into the thehackerdispatch-config ConfigMap. One KEY=value per
# line, no quotes. Secrets go in secrets.env.

# Required: the public URL of the portal, the same host as in ingress.yaml.
BASE_URL=https://news.example.com

# Optional SSO (OpenID Connect, e.g. a Keycloak realm). Set both, and OIDC_CLIENT_SECRET in secrets.env.
# OIDC_ISSUER_URL=https://sso.example.com/realms/company
# OIDC_CLIENT_ID=thehackerdispatch

# Optional: debug, info (default), warn or error.
# LOG_LEVEL=info
